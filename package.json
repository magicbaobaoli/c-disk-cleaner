{
  "name": "dsh-cleaner",
  "version": "0.4.0",
  "description": "C Disk Cleaner — 右上角一枚小垃圾桶，随时点一下清理 DSH 缓存、释放 C 盘空间。可拖动，清理时按钮亮红光、完成闪绿光。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/client.test.mjs && node test/host.test.mjs"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "node": "^22.19 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh",
    "dsh-plugin",
    "cache",
    "cleaner",
    "disk-space",
    "cleanup",
    "c-disk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicbaobaoli/dsh-cleaner.git"
  }
}
